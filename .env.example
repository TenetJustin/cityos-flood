# CITY OS · 环境变量模板（复制为 .env 并填入真实值；.env 已 gitignore）
# 真实凭据只保存在本机密钥环境中；任何文档和仓库文件都不得记录真实值

# 深圳市政府数据开放平台（下载需登录会话；JSESSIONID 有有效期，失效需重新登录获取）
SZ_OPENDATA_JSESSIONID=your_jsessionid_here
SZ_OPENDATA_ARIAAPPID=your_ariaappid_here

# 天地图 API（浏览器端 key，调用需 Referer: https://lbs.tianditu.gov.cn/）
TIANDITU_KEY=your_tianditu_key_here

# （可选）真实数据目录环境变量：ml/realdata.py 用它定位深圳开放平台 P0 数据
SHENZHEN_P0_DATA=

# 可选研究数据根目录；缺省为 backend/data/external/（此目录不提交到 Git）
# 深圳旧数据工作区可将此项设为原 shenzhen-flood/data 的绝对路径
CITYOS_EXTERNAL_DATA_DIR=

# 城安助手大模型（OpenAI 兼容接口）
LLM_BASE_URL=https://newapi.aihuashen.com/v1
LLM_API_KEY=your_key_here
LLM_MODEL=deepseek-v4-flash-vision-exp

# RAG 语义检索（aiping.cn）
EMBED_API_BASE=https://aiping.cn/api/v1
EMBED_API_KEY=your_key_here
EMBED_MODEL=Qwen3-Embedding-8B
RERANK_MODEL=bge-reranker-v2-m3
